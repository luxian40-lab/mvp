{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "python .cursor/hooks/proteger_cuerpo.py",
        "timeout": 10
      }
    ],
    "postToolUse": [
      {
        "command": "python .cursor/hooks/ratchet_tras_editar.py",
        "timeout": 30
      }
    ],
    "beforeShellExecution": [
      {
        "command": "python .cursor/hooks/antes_de_deploy.py",
        "matcher": "eb",
        "timeout": 20
      }
    ]
  }
}
