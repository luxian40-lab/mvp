# option_settings: variables de entorno y WSGI (requerido en EB).
# migrate/collectstatic: .platform/hooks/predeploy/02_migrate.sh (evita duplicar y fallar el deploy).

option_settings:
  aws:elasticbeanstalk:application:environment:
    DJANGO_SETTINGS_MODULE: "mvp_project.settings_production"
    PYTHONPATH: "/var/app/current:$PYTHONPATH"
    RUN_MIGRATIONS: "true"

  aws:elasticbeanstalk:container:python:
    WSGIPath: "mvp_project.wsgi:application"

packages:
  yum:
    git: []

commands:
  00_install_ffmpeg:
    command: |
      set -e
      if command -v ffmpeg >/dev/null 2>&1 && command -v ffprobe >/dev/null 2>&1; then
        ffmpeg -version | head -1
        exit 0
      fi
      # AL2023: dnf packages often missing; fall back to static build (same as platform hook).
      dnf install -y https://dl.fedoraproject.org/pub/epel/epel-release-latest-9.noarch.rpm || true
      dnf install -y --allowerasing ffmpeg-free || dnf install -y --allowerasing ffmpeg || true
      if ! command -v ffmpeg >/dev/null 2>&1; then
        ARCH=$(uname -m)
        case "$ARCH" in
          x86_64|amd64) ASSET=ffmpeg-release-amd64-static.tar.xz ;;
          aarch64|arm64) ASSET=ffmpeg-release-arm64-static.tar.xz ;;
          *) echo "no static ffmpeg for $ARCH"; exit 0 ;;
        esac
        TMP=$(mktemp -d)
        curl -fsSL -o "$TMP/ff.tar.xz" "https://johnvansickle.com/ffmpeg/releases/$ASSET"
        tar -xJf "$TMP/ff.tar.xz" -C "$TMP"
        BIN=$(find "$TMP" -maxdepth 1 -type d -name 'ffmpeg-*-static' | head -1)
        install -m 755 "$BIN/ffmpeg" /usr/local/bin/ffmpeg
        install -m 755 "$BIN/ffprobe" /usr/local/bin/ffprobe
        rm -rf "$TMP"
      fi
      command -v ffmpeg
      ffmpeg -version | head -1
    ignoreErrors: true
  01_install_tesseract_ocr:
    command: |
      if ! command -v tesseract &> /dev/null; then
        dnf install -y tesseract tesseract-langpack-spa tesseract-langpack-eng || \
        dnf install -y tesseract tesseract-langpack-spa || \
        echo "tesseract install skipped - PDF OCR deshabilitado"
      fi
    ignoreErrors: true
  02_chroma_data_dir:
    command: |
      # CHROMA_DB_DIR desde env EB (EFS: /mnt/efs/chroma_data). Fallback instancia.
      ENVF=/opt/elasticbeanstalk/deployment/env
      if [ -f "$ENVF" ]; then
        set -a; . "$ENVF" 2>/dev/null || true; set +a
      fi
      CHROMA_DIR="${CHROMA_DB_DIR:-/var/app/chroma_data}"
      mkdir -p "$CHROMA_DIR"
      chown -R webapp:webapp "$CHROMA_DIR" || chown -R ec2-user:webapp "$CHROMA_DIR" || true
      chmod 775 "$CHROMA_DIR" || true
      echo "CHROMA_DB_DIR=$CHROMA_DIR"
    ignoreErrors: true
