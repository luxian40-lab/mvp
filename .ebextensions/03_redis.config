# Redis local para Celery worker + beat (single-instance EB).
# Broker por defecto: redis://127.0.0.1:6379/0 (ver settings_production.py).

packages:
  yum:
    redis6: []

commands:
  01_redis_bind_localhost:
    command: |
      for conf in /etc/redis6/redis6.conf /etc/redis/redis.conf; do
        if [ -f "$conf" ]; then
          sed -i 's/^bind .*/bind 127.0.0.1 -::1/' "$conf" 2>/dev/null || true
          sed -i 's/^protected-mode .*/protected-mode yes/' "$conf" 2>/dev/null || true
        fi
      done
    ignoreErrors: true
  02_redis_enable:
    command: |
      if systemctl list-unit-files | grep -q '^redis6\.service'; then
        systemctl enable redis6
        systemctl restart redis6
      elif systemctl list-unit-files | grep -q '^redis\.service'; then
        systemctl enable redis
        systemctl restart redis
      fi
    ignoreErrors: false

services:
  sysvinit:
    redis6:
      enabled: true
      ensureRunning: true
