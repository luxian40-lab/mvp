# Redis local para Celery (solo si NO hay broker externo).
# Con ElastiCache: setear CELERY_BROKER_URL o REDIS_URL y USE_LOCAL_REDIS=0 en EB.
# Ver docs/RUNBOOK_REDIS_CHROMA.md

packages:
  yum:
    redis6: []

commands:
  00_skip_if_external_redis:
    # Si USE_LOCAL_REDIS=0, no tocamos el servicio (ElastiCache).
    # EB inyecta env en /opt/elasticbeanstalk/deployment/env al apply.
    command: |
      ENVF=/opt/elasticbeanstalk/deployment/env
      USE_LOCAL=1
      if [ -f "$ENVF" ]; then
        # shellcheck disable=SC1090
        set -a; . "$ENVF" 2>/dev/null || true; set +a
      fi
      case "${USE_LOCAL_REDIS:-1}" in
        0|false|FALSE|no|NO|off|OFF) USE_LOCAL=0 ;;
      esac
      BROKER="${CELERY_BROKER_URL:-${REDIS_URL:-}}"
      case "$BROKER" in
        redis://127.0.0.1*|redis://localhost*|"" ) ;;
        redis://*|rediss://*) USE_LOCAL=0 ;;
      esac
      echo "$USE_LOCAL" > /tmp/eki_use_local_redis
      echo "USE_LOCAL_REDIS_EFFECTIVE=$USE_LOCAL broker=${BROKER:-(default)}"
    ignoreErrors: true
  01_redis_bind_localhost:
    test: test "$(cat /tmp/eki_use_local_redis 2>/dev/null || echo 1)" = "1"
    command: |
      for conf in /etc/redis6/redis6.conf /etc/redis/redis.conf; do
        if [ -f "$conf" ]; then
          sed -i 's/^bind .*/bind 127.0.0.1 -::1/' "$conf" 2>/dev/null || true
          sed -i 's/^protected-mode .*/protected-mode yes/' "$conf" 2>/dev/null || true
        fi
      done
    ignoreErrors: true
  02_redis_enable:
    test: test "$(cat /tmp/eki_use_local_redis 2>/dev/null || echo 1)" = "1"
    command: |
      if systemctl list-unit-files | grep -q '^redis6\.service'; then
        systemctl enable redis6
        systemctl restart redis6
      elif systemctl list-unit-files | grep -q '^redis\.service'; then
        systemctl enable redis
        systemctl restart redis
      fi
    ignoreErrors: false

# Nota: no forzamos services.sysvinit aquí.
# El start/enable lo hacen commands (01/02) + postdeploy hook solo si USE_LOCAL=1.
# Así, con ElastiCache, un fallo de redis6 local no tumba el deploy.
