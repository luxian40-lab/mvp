# ================================================================================
# 🔐 .ENV PARA DEPLOYMENT - EKI MVP
# ================================================================================
# Este archivo contiene TODAS las variables necesarias para deployar.
# IMPORTANTE: Cambiar XXX por valores reales
# NUNCA compartir este archivo por email o git
# ================================================================================

# ============================================================================
# DJANGO CONFIGURACIÓN
# ============================================================================

# Clave secreta (generar una segura antes de producción)
# Genera aquí: python manage.py shell
# >>> from django.core.management.utils import get_random_secret_key
# >>> print(get_random_secret_key())
SECRET_KEY=XXX_GENERAR_CLAVE_SEGURA_XXX

# Modo debug (DEBE SER False en producción)
DJANGO_DEBUG=False

# Hosts permitidos (separados por coma)
# Ejemplo: localhost,127.0.0.1,tu-dominio.com,eki-mvp.onrender.com
ALLOWED_HOSTS=localhost,127.0.0.1,tu-dominio-aqui.com

# CSRF y CORS
CSRF_TRUSTED_ORIGINS=http://localhost:8000,https://tu-dominio-aqui.com


# ============================================================================
# BASE DE DATOS
# ============================================================================

# DESARROLLO (SQLite - sin contraseña)
# DATABASE_URL=sqlite:///db.sqlite3

# PRODUCCIÓN (PostgreSQL)
# Formato: postgresql://usuario:contraseña@host:puerto/nombre_bd
# Render genera algo como: postgresql://user:xxx@dpg-xxx.render.dev/eki_db
DATABASE_URL=postgresql://XXX_USUARIO_XXX:XXX_PASSWORD_XXX@XXX_HOST_XXX:5432/XXX_DB_NAME_XXX


# ============================================================================
# TWILIO (WhatsApp)
# ============================================================================

# Tus credenciales de Twilio (obtener en https://console.twilio.com)
TWILIO_ACCOUNT_SID=XXX_ACCOUNT_SID_XXX
TWILIO_AUTH_TOKEN=XXX_AUTH_TOKEN_XXX

# Número de Twilio (te lo da Twilio cuando creas la app)
# Formato: +1234567890
TWILIO_PHONE_NUMBER=XXX_TU_NUMERO_TWILIO_XXX

# Número WhatsApp que usa Twilio (generalmente comienza con whatsapp:)
TWILIO_WHATSAPP_FROM=whatsapp:XXX_NUMERO_WHATSAPP_XXX


# ============================================================================
# IA Y PROCESAMIENTO
# ============================================================================

# OpenAI (para respuestas empáticas, fallback IA)
# Obtener en https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-XXX_CLAVE_OPENAI_XXX

# Cohere (alternativa IA)
COHERE_API_KEY=XXX_CLAVE_COHERE_XXX

# Google Gemini (alternativa IA)
GEMINI_API_KEY=XXX_CLAVE_GEMINI_XXX


# ============================================================================
# AWS S3 (Almacenamiento en la nube - OPCIONAL)
# ============================================================================

# Si usas S3 para guardar PDFs, videos, etc.
USE_S3=False

# Credenciales AWS (obtener en https://aws.amazon.com)
AWS_ACCESS_KEY_ID=XXX_ACCESS_KEY_XXX
AWS_SECRET_ACCESS_KEY=XXX_SECRET_ACCESS_KEY_XXX
AWS_STORAGE_BUCKET_NAME=eki-storage-bucket
AWS_S3_REGION_NAME=us-east-1


# ============================================================================
# EMAIL (Para notificaciones de soporte)
# ============================================================================

# OPCIÓN 1: Gmail
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tu_email@gmail.com
EMAIL_HOST_PASSWORD=XXX_PASSWORD_APLICACION_GMAIL_XXX

# OPCIÓN 2: SendGrid
# EMAIL_BACKEND=sendgrid_backend.SendgridBackend
# SENDGRID_API_KEY=XXX_SENDGRID_API_KEY_XXX

# OPCIÓN 3: Postmark
# EMAIL_BACKEND=postmark.django_backend.EmailBackend
# POSTMARK_SERVER_TOKEN=XXX_POSTMARK_TOKEN_XXX

# Email de soporte (donde llegan los tickets)
EMAIL_SOPORTE=soporte@tu-dominio.com


# ============================================================================
# VOSK (Transcripción de audio - ASR)
# ============================================================================

# Ruta al modelo VOSK (descargarlo previamente)
# Descarga: https://alphacephei.com/vosk/models/
# Archivo: vosk-model-small-es-0.42.zip
VOSK_MODEL_PATH=./models/vosk-model-small-es-0.42


# ============================================================================
# CONFIGURACIÓN DE APLICACIÓN
# ============================================================================

# Centro de formación por defecto
DEFAULT_CLIENTE_ID=1

# Email de contacto para reportes
CONTACT_EMAIL=info@tu-dominio.com

# Teléfono de soporte
SUPPORT_PHONE=+57XXXXXXXXXX


# ============================================================================
# RATE LIMITING (Protección contra spam)
# ============================================================================

RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS=100        # Máximo de requests
RATE_LIMIT_PERIOD=60           # En segundos
WHATSAPP_RATE_LIMIT=5          # Máximo de mensajes
WHATSAPP_RATE_PERIOD=60        # En segundos


# ============================================================================
# LOGGING (Información de debugging)
# ============================================================================

LOG_LEVEL=INFO                  # DEBUG, INFO, WARNING, ERROR
SENTRY_DSN=                     # Para error tracking (opcional)


# ============================================================================
# CONFIGURACIÓN DE CACHÉ
# ============================================================================

# Redis (si usas caché)
REDIS_URL=redis://localhost:6379


# ============================================================================
# CONFIGURACIÓN AVANZADA
# ============================================================================

# Zona horaria
TIME_ZONE=America/Bogota

# Idioma
LANGUAGE_CODE=es-CO

# Variables adicionales que Django necesita
PYTHONUNBUFFERED=1
PORT=8000
