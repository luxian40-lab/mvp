# eki-ai-workers — inst. 2 t3.small (sin beat; colas pesadas IA/media)
web: gunicorn mvp_project.wsgi:application --worker-class gthread --workers 1 --threads 2 --timeout 120 --bind 0.0.0.0:8000 --log-level info
worker_media: celery -A mvp_project worker -Q media_encode -n media@%h --loglevel=info --concurrency=1 --max-tasks-per-child=30
worker_rag: celery -A mvp_project worker -Q rag_index -n rag@%h --loglevel=info --concurrency=1 --max-tasks-per-child=20
worker_course: celery -A mvp_project worker -Q course_engine -n ce@%h --loglevel=info --concurrency=1 --max-tasks-per-child=10
