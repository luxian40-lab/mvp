{% extends "admin/base_site.html" %}
{% load static %}

{% block title %}🚀 Centro de Control - Eki{% endblock %}

{% block extrahead %}
<!-- Chart.js para gráficas -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<!-- Font Awesome para iconos -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
<!-- Google Fonts -->
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

<style>
/* ===========================================
   DASHBOARD DE CONTROL EXCEPCIONAL - EKI
   Centro de Control Premium con UX Avanzada
   =========================================== */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root {
    --primary: #667eea;
    --primary-dark: #5568d3;
    --secondary: #764ba2;
    --success: #10b981;
    --warning: #f59e0b;
    --danger: #ef4444;
    --info: #3b82f6;
    --dark: #1e293b;
    --light: #f1f5f9;
    --white: #ffffff;
    --shadow-sm: 0 1px 3px 0 rgba(0, 0, 0, 0.1);
    --shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    --shadow-lg: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
    --radius: 16px;
    --radius-sm: 8px;
}

body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    min-height: 100vh;
}

.dashboard-container {
    padding: 30px;
    max-width: 1800px;
    margin: 0 auto;
}

/* ========== HEADER PREMIUM ========== */
.dashboard-header {
    background: var(--white);
    border-radius: var(--radius);
    padding: 40px;
    margin-bottom: 30px;
    box-shadow: var(--shadow-lg);
    position: relative;
    overflow: hidden;
}

.dashboard-header::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 300px;
    height: 300px;
    background: radial-gradient(circle, rgba(102, 126, 234, 0.1) 0%, transparent 70%);
    border-radius: 50%;
}

.header-content {
    position: relative;
    z-index: 1;
}

.dashboard-title {
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--dark);
    margin-bottom: 10px;
    display: flex;
    align-items: center;
    gap: 15px;
}

.title-icon {
    font-size: 3rem;
    animation: float 3s ease-in-out infinite;
}

@keyframes float {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-10px); }
}

.dashboard-subtitle {
    font-size: 1.1rem;
    color: #64748b;
    margin-bottom: 20px;
}

.header-meta {
    display: flex;
    align-items: center;
    gap: 30px;
    flex-wrap: wrap;
    margin-top: 20px;
}

.meta-item {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    background: var(--light);
    border-radius: var(--radius-sm);
    font-size: 0.9rem;
    color: var(--dark);
}

.meta-icon {
    font-size: 1.2rem;
}

.live-indicator {
    width: 10px;
    height: 10px;
    background: var(--success);
    border-radius: 50%;
    animation: pulse 2s ease-in-out infinite;
}

@keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(1.1); }
}

/* ========== ALERTAS ========== */
.alerts-container {
    margin-bottom: 30px;
}

.alert-card {
    background: var(--white);
    border-radius: var(--radius);
    padding: 20px 25px;
    margin-bottom: 15px;
    box-shadow: var(--shadow);
    border-left: 4px solid;
    display: flex;
    align-items: center;
    gap: 15px;
    animation: slideIn 0.5s ease-out;
}

@keyframes slideIn {
    from { transform: translateX(-20px); opacity: 0; }
    to { transform: translateX(0); opacity: 1; }
}

.alert-card.error { border-left-color: var(--danger); }
.alert-card.warning { border-left-color: var(--warning); }
.alert-card.info { border-left-color: var(--info); }

.alert-icon {
    font-size: 2rem;
    flex-shrink: 0;
}

.alert-content h4 {
    font-weight: 600;
    color: var(--dark);
    margin-bottom: 5px;
}

.alert-content p {
    color: #64748b;
    font-size: 0.9rem;
}

/* ========== KPI CARDS ========== */
.kpis-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 20px;
    margin-bottom: 30px;
}

.kpi-card {
    background: var(--white);
    border-radius: var(--radius);
    padding: 30px;
    box-shadow: var(--shadow-lg);
    position: relative;
    overflow: hidden;
    transition: all 0.3s ease;
    cursor: pointer;
}

.kpi-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
}

.kpi-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 6px;
    background: linear-gradient(90deg, var(--card-color) 0%, transparent 100%);
}

.kpi-card.success { --card-color: var(--success); }
.kpi-card.primary { --card-color: var(--primary); }
.kpi-card.warning { --card-color: var(--warning); }
.kpi-card.info { --card-color: var(--info); }
.kpi-card.danger { --card-color: var(--danger); }

.kpi-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 20px;
}

.kpi-icon {
    font-size: 3rem;
    opacity: 0.9;
}

.kpi-trend {
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 5px;
}

.kpi-trend.up {
    background: #d1fae5;
    color: var(--success);
}

.kpi-trend.down {
    background: #fee2e2;
    color: var(--danger);
}

.kpi-content h3 {
    font-size: 0.95rem;
    font-weight: 600;
    color: #64748b;
    margin-bottom: 10px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.kpi-value {
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--dark);
    margin-bottom: 8px;
}

.kpi-label {
    font-size: 0.9rem;
    color: #94a3b8;
}

/* ========== SECCIONES PRINCIPALES ========== */
.dashboard-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 20px;
    margin-bottom: 30px;
}

.section-card {
    background: var(--white);
    border-radius: var(--radius);
    padding: 30px;
    box-shadow: var(--shadow-lg);
}

.col-12 { grid-column: span 12; }
.col-8 { grid-column: span 8; }
.col-6 { grid-column: span 6; }
.col-4 { grid-column: span 4; }

@media (max-width: 1200px) {
    .col-8, .col-6, .col-4 { grid-column: span 12; }
}

.section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 25px;
    padding-bottom: 15px;
    border-bottom: 2px solid var(--light);
}

.section-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--dark);
    display: flex;
    align-items: center;
    gap: 10px;
}

.section-action {
    padding: 8px 16px;
    background: var(--primary);
    color: var(--white);
    border-radius: var(--radius-sm);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
    transition: all 0.3s ease;
}

.section-action:hover {
    background: var(--primary-dark);
    transform: translateY(-2px);
}

/* ========== TABLA DE DATOS ========== */
.data-table {
    width: 100%;
    border-collapse: collapse;
}

.data-table thead {
    background: var(--light);
}

.data-table th {
    padding: 15px;
    text-align: left;
    font-weight: 600;
    color: var(--dark);
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.data-table td {
    padding: 15px;
    border-bottom: 1px solid var(--light);
    color: #475569;
}

.data-table tbody tr {
    transition: all 0.2s ease;
}

.data-table tbody tr:hover {
    background: #f8fafc;
}

.table-badge {
    padding: 4px 12px;
    border-radius: 12px;
    font-size: 0.85rem;
    font-weight: 600;
    display: inline-block;
}

.badge-success {
    background: #d1fae5;
    color: var(--success);
}

.badge-warning {
    background: #fef3c7;
    color: var(--warning);
}

.badge-danger {
    background: #fee2e2;
    color: var(--danger);
}

.badge-info {
    background: #dbeafe;
    color: var(--info);
}

/* ========== ESTADÍSTICAS INLINE ========== */
.stats-list {
    list-style: none;
}

.stat-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 15px 0;
    border-bottom: 1px solid var(--light);
}

.stat-item:last-child {
    border-bottom: none;
}

.stat-label {
    font-weight: 500;
    color: #475569;
    display: flex;
    align-items: center;
    gap: 10px;
}

.stat-value {
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--dark);
}

/* ========== GRÁFICA ========== */
.chart-container {
    position: relative;
    height: 350px;
    margin-top: 20px;
}

/* ========== PROGRESO ========== */
.progress-bar-container {
    margin-top: 15px;
}

.progress-label {
    display: flex;
    justify-content: space-between;
    margin-bottom: 8px;
    font-size: 0.9rem;
}

.progress-bar-bg {
    width: 100%;
    height: 12px;
    background: var(--light);
    border-radius: 20px;
    overflow: hidden;
}

.progress-bar-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--primary) 0%, var(--secondary) 100%);
    border-radius: 20px;
    transition: width 1s ease-out;
}

/* ========== CLIENTES GRID ========== */
.clientes-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 15px;
    margin-top: 20px;
}

.cliente-card {
    background: var(--light);
    border-radius: var(--radius-sm);
    padding: 20px;
    transition: all 0.3s ease;
}

.cliente-card:hover {
    background: #e2e8f0;
    transform: translateY(-3px);
}

.cliente-name {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--dark);
    margin-bottom: 15px;
}

.cliente-stats {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.cliente-stat-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.9rem;
}

.cliente-stat-label {
    color: #64748b;
}

.cliente-stat-value {
    font-weight: 600;
    color: var(--dark);
}

/* ========== RESPONSIVE ========== */
@media (max-width: 768px) {
    .dashboard-container {
        padding: 15px;
    }
    
    .dashboard-title {
        font-size: 1.8rem;
    }
    
    .kpis-grid {
        grid-template-columns: 1fr;
    }
    
    .header-meta {
        flex-direction: column;
        align-items: flex-start;
    }
}

/* ========== ANIMACIONES ========== */
@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateY(30px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.fade-in-up {
    animation: fadeInUp 0.6s ease-out forwards;
}

/* ========== LOADER ========== */
.spinner {
    display: inline-block;
    width: 20px;
    height: 20px;
    border: 3px solid rgba(255,255,255,.3);
    border-radius: 50%;
    border-top-color: var(--white);
    animation: spin 1s ease-in-out infinite;
}

@keyframes spin {
    to { transform: rotate(360deg); }
}
</style>
{% endblock %}

{% block content %}
    height: 100%;
    background: var(--primary-color);
}

.kpi-card.success::before { background: var(--success-color); }
.kpi-card.warning::before { background: var(--warning-color); }
.kpi-card.danger::before { background: var(--danger-color); }
.kpi-card.info::before { background: var(--info-color); }

.kpi-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 30px rgba(0,0,0,0.15);
}

.kpi-icon {
    font-size: 2.5rem;
    margin-bottom: 15px;
    display: block;
}

.kpi-title {
    font-size: 0.9rem;
    color: #666;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 10px;
}

.kpi-value {
    font-size: 2.2rem;
    font-weight: 700;
    color: var(--dark-color);
    margin-bottom: 8px;
}

.kpi-change {
    font-size: 0.85rem;
    font-weight: 600;
    padding: 4px 8px;
    border-radius: 20px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
}

.kpi-change.up {
    background: rgba(76, 175, 80, 0.1);
    color: var(--success-color);
}

.kpi-change.down {
    background: rgba(244, 67, 54, 0.1);
    color: var(--danger-color);
}

/* ========== ALERTAS ========== */
.alerts-section {
    margin-bottom: 30px;
}

.alerts-container {
    display: flex;
    flex-direction: column;
    gap: 15px;
}

.alert-card {
    background: white;
    border-radius: var(--border-radius);
    padding: 20px;
    box-shadow: var(--card-shadow);
    border-left: 4px solid;
    display: flex;
    align-items: center;
    gap: 15px;
    animation: slideIn 0.5s ease-out;
}

.alert-card.error { border-left-color: var(--danger-color); }
.alert-card.warning { border-left-color: var(--warning-color); }
.alert-card.info { border-left-color: var(--info-color); }
.alert-card.success { border-left-color: var(--success-color); }

.alert-icon {
    font-size: 1.5rem;
}

.alert-content h4 {
    margin: 0 0 5px 0;
    font-size: 1rem;
    font-weight: 600;
    color: var(--dark-color);
}

.alert-content p {
    margin: 0;
    font-size: 0.9rem;
    color: #666;
}

/* ========== CONTENIDO PRINCIPAL ========== */
.main-content {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 30px;
}

/* ========== SECCIONES ========== */
.section {
    background: white;
    border-radius: var(--border-radius);
    padding: 25px;
    box-shadow: var(--card-shadow);
    margin-bottom: 30px;
}

.section-title {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--dark-color);
    margin: 0 0 20px 0;
    display: flex;
    align-items: center;
    gap: 10px;
}

.section-icon {
    font-size: 1.2rem;
}

/* ========== GRÁFICAS ========== */
.chart-container {
    position: relative;
    height: 300px;
    margin: 20px 0;
}

/* ========== MÉTRICAS GRID ========== */
.metrics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 20px;
    margin-bottom: 20px;
}

.metric-item {
    text-align: center;
    padding: 20px;
    background: var(--light-bg);
    border-radius: 8px;
    border: 1px solid rgba(0,0,0,0.05);
}

.metric-value {
    font-size: 1.8rem;
    font-weight: 700;
    color: var(--primary-color);
    display: block;
    margin-bottom: 5px;
}

.metric-label {
    font-size: 0.85rem;
    color: #666;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

/* ========== TABLAS ========== */
.table-responsive {
    overflow-x: auto;
    margin-top: 15px;
}

.table-modern {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
}

.table-modern th,
.table-modern td {
    padding: 12px 15px;
    text-align: left;
    border-bottom: 1px solid #eee;
}

.table-modern th {
    background: var(--light-bg);
    font-weight: 600;
    color: var(--dark-color);
    text-transform: uppercase;
    font-size: 0.8rem;
    letter-spacing: 0.5px;
}

.table-modern tr:hover {
    background: rgba(33, 150, 243, 0.02);
}

/* ========== PROGRESS BARS ========== */
.progress-container {
    margin: 15px 0;
}

.progress-bar {
    width: 100%;
    height: 8px;
    background: #eee;
    border-radius: 4px;
    overflow: hidden;
    margin-bottom: 5px;
}

.progress-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--primary-color), var(--success-color));
    border-radius: 4px;
    transition: width 0.3s ease;
}

.progress-text {
    font-size: 0.8rem;
    color: #666;
    text-align: right;
}

/* ========== SIDEBAR ========== */
.sidebar {
    position: sticky;
    top: 20px;
}

.sidebar-section {
    background: white;
    border-radius: var(--border-radius);
    padding: 20px;
    box-shadow: var(--card-shadow);
    margin-bottom: 20px;
}

.sidebar-title {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--dark-color);
    margin: 0 0 15px 0;
    display: flex;
    align-items: center;
    gap: 8px;
}

/* ========== ANIMACIONES ========== */
@keyframes slideIn {
    from {
        opacity: 0;
        transform: translateX(-20px);
    }
    to {
        opacity: 1;
        transform: translateX(0);
    }
}

@keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
}

.fade-in {
    animation: fadeIn 0.5s ease-out;
}

/* ========== RESPONSIVE ========== */
@media (max-width: 1200px) {
    .main-content {
        grid-template-columns: 1fr;
    }

    .kpis-grid {
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    }
}

@media (max-width: 768px) {
    .dashboard-title {
        font-size: 2rem;
    }

    .kpis-grid {
        grid-template-columns: 1fr;
    }

    .metrics-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .section {
        padding: 20px;
    }
}

@media (max-width: 480px) {
    .metrics-grid {
        grid-template-columns: 1fr;
    }

    .dashboard-container {
        padding: 15px;
    }

    .kpi-card {
        padding: 20px;
    }
}

/* ========== LOADING ========== */
.loading {
    display: inline-block;
    width: 20px;
    height: 20px;
    border: 3px solid rgba(255,255,255,0.3);
    border-radius: 50%;
    border-top-color: white;
    animation: spin 1s ease-in-out infinite;
}

@keyframes spin {
    to { transform: rotate(360deg); }
}

/* ========== STATUS BADGES ========== */
.status-badge {
    padding: 4px 8px;
    border-radius: 12px;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
}

.status-success {
    background: rgba(76, 175, 80, 0.1);
    color: var(--success-color);
}

.status-warning {
    background: rgba(255, 152, 0, 0.1);
    color: var(--warning-color);
}

.status-danger {
    background: rgba(244, 67, 54, 0.1);
    color: var(--danger-color);
}

.status-info {
    background: rgba(0, 188, 212, 0.1);
    color: var(--info-color);
}
</style>
{% endblock %}

{% block content %}
<div class="dashboard-container">
    <!-- ========== HEADER ========== -->
    <div class="dashboard-header">
        <h1 class="dashboard-title">
            🚀 Centro de Control Eki
        </h1>
        <p class="dashboard-subtitle">
            <i class="fas fa-chart-line"></i>
            Panel de control en tiempo real - Última actualización: {{ fecha_actualizacion }}
        </p>
    </div>

    <!-- ========== ALERTAS ========== -->
    {% if alertas %}
    <div class="alerts-section">
        <div class="alerts-container">
            {% for alerta in alertas %}
            <div class="alert-card {{ alerta.tipo }}">
                <span class="alert-icon">{{ alerta.icono }}</span>
                <div class="alert-content">
                    <h4>{{ alerta.titulo }}</h4>
                    <p>{{ alerta.mensaje }}</p>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
    {% endif %}

    <!-- ========== KPIs ========== -->
    <div class="kpis-grid">
        {% for kpi in kpis %}
        <div class="kpi-card {{ kpi.color }}">
            <span class="kpi-icon">{{ kpi.icono }}</span>
            <div class="kpi-title">{{ kpi.titulo }}</div>
            <div class="kpi-value">{{ kpi.valor }}</div>
            <span class="kpi-change {{ kpi.tendencia }}">
                <i class="fas fa-arrow-{{ kpi.tendencia }}"></i>
                {{ kpi.cambio }}
            </span>
        </div>
        {% endfor %}
    </div>

    <!-- ========== CONTENIDO PRINCIPAL ========== -->
    <div class="main-content">
        <!-- ========== COLUMNA PRINCIPAL ========== -->
        <div class="main-column">
            <!-- ========== ACTIVIDAD MENSUAL ========== -->
            <div class="section">
                <h2 class="section-title">
                    <i class="fas fa-chart-bar section-icon"></i>
                    Actividad de Mensajería (30 días)
                </h2>
                <div class="chart-container">
                    <canvas id="mensajesChart"></canvas>
                </div>
            </div>

            <!-- ========== MÉTRICAS POR SECCIONES ========== -->
            <div class="section">
                <h2 class="section-title">
                    <i class="fas fa-users section-icon"></i>
                    Gestión de Estudiantes
                </h2>
                <div class="metrics-grid">
                    <div class="metric-item">
                        <span class="metric-value">{{ total_estudiantes|number_format }}</span>
                        <span class="metric-label">Total Estudiantes</span>
                    </div>
                    <div class="metric-item">
                        <span class="metric-value">{{ estudiantes_activos|number_format }}</span>
                        <span class="metric-label">Estudiantes Activos</span>
                    </div>
                    <div class="metric-item">
                        <span class="metric-value">{{ estudiantes_nuevos_30d }}</span>
                        <span class="metric-label">Nuevos (30 días)</span>
                    </div>
                    <div class="metric-item">
                        <span class="metric-value">{{ estudiantes_nuevos_7d }}</span>
                        <span class="metric-label">Nuevos (7 días)</span>
                    </div>
                </div>
            </div>

            <!-- ========== CAMPAÑAS Y MENSAJERÍA ========== -->
            <div class="section">
                <h2 class="section-title">
                    <i class="fas fa-bullhorn section-icon"></i>
                    Campañas y Mensajería
                </h2>
                <div class="metrics-grid">
                    <div class="metric-item">
                        <span class="metric-value">{{ total_campanas }}</span>
                        <span class="metric-label">Total Campañas</span>
                    </div>
                    <div class="metric-item">
                        <span class="metric-value">{{ campanas_ejecutadas }}</span>
                        <span class="metric-label">Campañas Ejecutadas</span>
                    </div>
                    <div class="metric-item">
                        <span class="metric-value">{{ total_mensajes|number_format }}</span>
                        <span class="metric-label">Total Mensajes</span>
                    </div>
                    <div class="metric-item">
                        <span class="metric-value">{{ mensajes_7d|number_format }}</span>
                        <span class="metric-label">Mensajes (7 días)</span>
                    </div>
                </div>

                <div class="metrics-grid">
                    <div class="metric-item">
                        <span class="metric-value">{{ tasa_exito_campanas }}%</span>
                        <span class="metric-label">Tasa Éxito Campañas</span>
                    </div>
                    <div class="metric-item">
                        <span class="metric-value">{{ mensajes_enviados|number_format }}</span>
                        <span class="metric-label">Mensajes Enviados</span>
                    </div>
                    <div class="metric-item">
                        <span class="metric-value">{{ mensajes_recibidos|number_format }}</span>
                        <span class="metric-label">Mensajes Recibidos</span>
                    </div>
                    <div class="metric-item">
                        <span class="metric-value">{{ mensajes_error }}</span>
                        <span class="metric-label">Mensajes con Error</span>
                    </div>
                </div>
            </div>

            <!-- ========== EDUCACIÓN ========== -->
            <div class="section">
                <h2 class="section-title">
                    <i class="fas fa-graduation-cap section-icon"></i>
                    Sistema Educativo
                </h2>
                <div class="metrics-grid">
                    <div class="metric-item">
                        <span class="metric-value">{{ total_cursos }}</span>
                        <span class="metric-label">Total Cursos</span>
                    </div>
                    <div class="metric-item">
                        <span class="metric-value">{{ estudiantes_inscritos }}</span>
                        <span class="metric-label">Estudiantes Inscritos</span>
                    </div>
                    <div class="metric-item">
                        <span class="metric-value">{{ cursos_completados }}</span>
                        <span class="metric-label">Cursos Completados</span>
                    </div>
                    <div class="metric-item">
                        <span class="metric-value">{{ tasa_completacion }}%</span>
                        <span class="metric-label">Tasa Completación</span>
                    </div>
                </div>

                {% if progreso_cursos %}
                <h3 style="margin-top: 25px; margin-bottom: 15px; color: var(--dark-color);">Progreso por Curso</h3>
                <div class="table-responsive">
                    <table class="table-modern">
                        <thead>
                            <tr>
                                <th>Curso</th>
                                <th>Inscritos</th>
                                <th>Completados</th>
                                <th>Progreso</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for curso in progreso_cursos %}
                            <tr>
                                <td>{{ curso.curso.emoji }} {{ curso.curso.nombre }}</td>
                                <td>{{ curso.inscritos }}</td>
                                <td>{{ curso.completados }}</td>
                                <td>
                                    <div class="progress-container">
                                        <div class="progress-bar">
                                            <div class="progress-fill" style="width: {{ curso.porcentaje }}%"></div>
                                        </div>
                                        <div class="progress-text">{{ curso.porcentaje }}%</div>
                                    </div>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                {% endif %}
            </div>

            <!-- ========== PLANTILLAS ========== -->
            <div class="section">
                <h2 class="section-title">
                    <i class="fas fa-file-alt section-icon"></i>
                    Gestión de Plantillas
                </h2>
                <div class="metrics-grid">
                    <div class="metric-item">
                        <span class="metric-value">{{ total_plantillas }}</span>
                        <span class="metric-label">Total Plantillas</span>
                    </div>
                    <div class="metric-item">
                        <span class="metric-value">{{ plantillas_activas }}</span>
                        <span class="metric-label">Plantillas Activas</span>
                    </div>
                    <div class="metric-item">
                        <span class="metric-value">{{ plantillas_twilio }}</span>
                        <span class="metric-label">Con Content Template</span>
                    </div>
                    <div class="metric-item">
                        <span class="metric-value">{{ top_plantillas|length }}</span>
                        <span class="metric-label">Plantillas Populares</span>
                    </div>
                </div>

                {% if top_plantillas %}
                <h3 style="margin-top: 25px; margin-bottom: 15px; color: var(--dark-color);">Plantillas Más Usadas</h3>
                <div class="table-responsive">
                    <table class="table-modern">
                        <thead>
                            <tr>
                                <th>Plantilla</th>
                                <th>Usos</th>
                                <th>Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for plantilla in top_plantillas %}
                            <tr>
                                <td>{{ plantilla.emoji }} {{ plantilla.nombre_interno }}</td>
                                <td>{{ plantilla.veces_usada }}</td>
                                <td>
                                    {% if plantilla.twilio_template_sid and plantilla.aprobada_twilio %}
                                        <span class="status-badge status-success">✅ TWILIO</span>
                                    {% elif plantilla.twilio_template_sid %}
                                        <span class="status-badge status-warning">⏳ PENDIENTE</span>
                                    {% else %}
                                        <span class="status-badge status-info">📱 DIRECTO</span>
                                    {% endif %}
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                {% endif %}
            </div>
        </div>

        <!-- ========== SIDEBAR ========== -->
        <div class="sidebar">
            <!-- ========== CLIENTES ========== -->
            <div class="sidebar-section">
                <h3 class="sidebar-title">
                    <i class="fas fa-building section-icon"></i>
                    Clientes
                </h3>
                <div class="metric-item" style="margin-bottom: 15px;">
                    <span class="metric-value">{{ total_clientes }}</span>
                    <span class="metric-label">Total Clientes</span>
                </div>
                <div class="metric-item">
                    <span class="metric-value">{{ clientes_activos }}</span>
                    <span class="metric-label">Clientes Activos</span>
                </div>

                {% if ingresos_por_cliente %}
                <h4 style="margin-top: 20px; margin-bottom: 10px; font-size: 0.9rem; color: var(--dark-color);">Ingresos Estimados</h4>
                <div style="max-height: 200px; overflow-y: auto;">
                    {% for cliente in ingresos_por_cliente %}
                    <div style="display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid #eee;">
                        <span style="font-size: 0.85rem;">{{ cliente.cliente }}</span>
                        <span style="font-weight: 600; color: var(--success-color);">${{ cliente.ingreso_estimado }}</span>
                    </div>
                    {% endfor %}
                </div>
                {% endif %}
            </div>

            <!-- ========== GAMIFICACIÓN ========== -->
            <div class="sidebar-section">
                <h3 class="sidebar-title">
                    <i class="fas fa-trophy section-icon"></i>
                    Gamificación
                </h3>
                <div class="metric-item" style="margin-bottom: 15px;">
                    <span class="metric-value">{{ total_puntos_otorgados|number_format }}</span>
                    <span class="metric-label">Puntos Otorgados</span>
                </div>
                <div class="metric-item" style="margin-bottom: 15px;">
                    <span class="metric-value">{{ total_puntos_canjeados|number_format }}</span>
                    <span class="metric-label">Puntos Canjeados</span>
                </div>
                <div class="metric-item" style="margin-bottom: 15px;">
                    <span class="metric-value">{{ total_badges }}</span>
                    <span class="metric-label">Total Badges</span>
                </div>
                <div class="metric-item">
                    <span class="metric-value">{{ badges_otorgados }}</span>
                    <span class="metric-label">Badges Otorgados</span>
                </div>
            </div>

            <!-- ========== SOPORTE ========== -->
            <div class="sidebar-section">
                <h3 class="sidebar-title">
                    <i class="fas fa-headset section-icon"></i>
                    Soporte
                </h3>
                <div class="metric-item" style="margin-bottom: 15px;">
                    <span class="metric-value">{{ total_solicitudes }}</span>
                    <span class="metric-label">Total Solicitudes</span>
                </div>
                <div class="metric-item" style="margin-bottom: 15px;">
                    <span class="metric-value {{ solicitudes_pendientes > 0 and 'danger' or 'success' }}">{{ solicitudes_pendientes }}</span>
                    <span class="metric-label">Pendientes</span>
                </div>
                <div class="metric-item" style="margin-bottom: 15px;">
                    <span class="metric-value">{{ solicitudes_atendiendo }}</span>
                    <span class="metric-label">En Atención</span>
                </div>
                <div class="metric-item">
                    <span class="metric-value">{{ solicitudes_resueltas }}</span>
                    <span class="metric-label">Resueltas</span>
                </div>
            </div>

            <!-- ========== CERTIFICADOS ========== -->
            <div class="sidebar-section">
                <h3 class="sidebar-title">
                    <i class="fas fa-certificate section-icon"></i>
                    Certificados
                </h3>
                <div class="metric-item" style="margin-bottom: 15px;">
                    <span class="metric-value">{{ total_certificados }}</span>
                    <span class="metric-label">Total Generados</span>
                </div>
                <div class="metric-item">
                    <span class="metric-value">{{ certificados_generados_30d }}</span>
                    <span class="metric-label">Últimos 30 días</span>
                </div>
{% block content %}
<div class="dashboard-container">
    
    <!-- ========== HEADER PREMIUM ========== -->
    <div class="dashboard-header fade-in-up">
        <div class="header-content">
            <h1 class="dashboard-title">
                <span class="title-icon">🚀</span>
                Centro de Control Eki
            </h1>
            <p class="dashboard-subtitle">
                Panel de administración y métricas en tiempo real
            </p>
            <div class="header-meta">
                <div class="meta-item">
                    <div class="live-indicator"></div>
                    <span><strong>En vivo</strong></span>
                </div>
                <div class="meta-item">
                    <span class="meta-icon">🕐</span>
                    <span>Actualizado: {{ fecha_actualizacion }}</span>
                </div>
                <div class="meta-item">
                    <span class="meta-icon">👥</span>
                    <span>{{ total_clientes }} Clientes</span>
                </div>
                <div class="meta-item">
                    <span class="meta-icon">📊</span>
                    <span>{{ total_estudiantes|default:0 }} Estudiantes</span>
                </div>
            </div>
        </div>
    </div>

    <!-- ========== ALERTAS ========== -->
    {% if alertas %}
    <div class="alerts-container fade-in-up">
        {% for alerta in alertas %}
        <div class="alert-card {{ alerta.tipo }}">
            <div class="alert-icon">{{ alerta.icono }}</div>
            <div class="alert-content">
                <h4>{{ alerta.titulo }}</h4>
                <p>{{ alerta.mensaje }}</p>
            </div>
        </div>
        {% endfor %}
    </div>
    {% endif %}

    <!-- ========== KPIs PRINCIPALES ========== -->
    <div class="kpis-grid fade-in-up">
        {% for kpi in kpis %}
        <div class="kpi-card {{ kpi.color }}">
            <div class="kpi-header">
                <span class="kpi-icon">{{ kpi.icono }}</span>
                {% if kpi.tendencia %}
                <span class="kpi-trend {{ kpi.tendencia }}">
                    {% if kpi.tendencia == 'up' %}▲{% else %}▼{% endif %}
                    {{ kpi.cambio }}
                </span>
                {% endif %}
            </div>
            <div class="kpi-content">
                <h3>{{ kpi.titulo }}</h3>
                <div class="kpi-value">{{ kpi.valor }}</div>
            </div>
        </div>
        {% endfor %}
    </div>

    <!-- ========== GRID PRINCIPAL ========== -->
    <div class="dashboard-grid">
        
        <!-- GRÁFICA DE ACTIVIDAD -->
        <div class="section-card col-8 fade-in-up">
            <div class="section-header">
                <h2 class="section-title">
                    📈 Actividad en Tiempo Real
                </h2>
                <select id="chartPeriod" style="padding: 8px 12px; border-radius: 8px; border: 1px solid #e2e8f0;">
                    <option value="7">Últimos 7 días</option>
                    <option value="30" selected>Últimos 30 días</option>
                    <option value="90">Últimos 90 días</option>
                </select>
            </div>
            <div class="chart-container">
                <canvas id="activityChart"></canvas>
            </div>
        </div>

        <!-- MÉTRICAS RÁPIDAS -->
        <div class="section-card col-4 fade-in-up">
            <div class="section-header">
                <h2 class="section-title">
                    ⚡ Métricas Rápidas
                </h2>
            </div>
            <ul class="stats-list">
                <li class="stat-item">
                    <span class="stat-label">
                        <span>💬</span> Mensajes (24h)
                    </span>
                    <span class="stat-value">{{ mensajes_24h|default:0 }}</span>
                </li>
                <li class="stat-item">
                    <span class="stat-label">
                        <span>📤</span> Enviados (7d)
                    </span>
                    <span class="stat-value">{{ mensajes_7d|default:0 }}</span>
                </li>
                <li class="stat-item">
                    <span class="stat-label">
                        <span>✅</span> Tasa Éxito
                    </span>
                    <span class="stat-value">{{ tasa_exito_mensajes|default:0 }}%</span>
                </li>
                <li class="stat-item">
                    <span class="stat-label">
                        <span>🎯</span> Campañas Activas
                    </span>
                    <span class="stat-value">{{ campanas_ejecutadas|default:0 }}</span>
                </li>
                <li class="stat-item">
                    <span class="stat-label">
                        <span>📅</span> Programadas
                    </span>
                    <span class="stat-value">{{ campanas_programadas|default:0 }}</span>
                </li>
                <li class="stat-item">
                    <span class="stat-label">
                        <span>📜</span> Certificados
                    </span>
                    <span class="stat-value">{{ total_certificados|default:0 }}</span>
                </li>
            </ul>
        </div>

        <!-- CLIENTES -->
        <div class="section-card col-12 fade-in-up">
            <div class="section-header">
                <h2 class="section-title">
                    🏢 Análisis por Cliente
                </h2>
                <a href="/admin/core/cliente/" class="section-action">Ver Todos</a>
            </div>
            <div class="clientes-grid">
                {% for est_cliente in estudiantes_por_cliente %}
                <div class="cliente-card">
                    <div class="cliente-name">{{ est_cliente.cliente__nombre|default:"Sin Cliente" }}</div>
                    <div class="cliente-stats">
                        <div class="cliente-stat-row">
                            <span class="cliente-stat-label">👥 Total:</span>
                            <span class="cliente-stat-value">{{ est_cliente.total }}</span>
                        </div>
                        <div class="cliente-stat-row">
                            <span class="cliente-stat-label">✅ Activos:</span>
                            <span class="cliente-stat-value">{{ est_cliente.activos }}</span>
                        </div>
                        <div class="cliente-stat-row">
                            <span class="cliente-stat-label">📊 Tasa:</span>
                            <span class="cliente-stat-value">
                                {% widthratio est_cliente.activos est_cliente.total 100 %}%
                            </span>
                        </div>
                    </div>
                </div>
                {% empty %}
                <p style="color: #94a3b8; padding: 20px;">No hay datos de clientes disponibles</p>
                {% endfor %}
            </div>
        </div>

        <!-- CURSOS -->
        <div class="section-card col-6 fade-in-up">
            <div class="section-header">
                <h2 class="section-title">
                    📚 Progreso de Cursos
                </h2>
                <a href="/admin/core/curso/" class="section-action">Ver Cursos</a>
            </div>
            {% for prog in progreso_cursos %}
            <div class="progress-bar-container">
                <div class="progress-label">
                    <span style="font-weight: 600; color: var(--dark);">{{ prog.curso.nombre }}</span>
                    <span style="color: #64748b;">{{ prog.completados }}/{{ prog.inscritos }} ({{ prog.porcentaje }}%)</span>
                </div>
                <div class="progress-bar-bg">
                    <div class="progress-bar-fill" style="width: {{ prog.porcentaje }}%;"></div>
                </div>
            </div>
            {% empty %}
            <p style="color: #94a3b8; padding: 20px;">No hay cursos con progreso registrado</p>
            {% endfor %}
        </div>

        <!-- PLANTILLAS -->
        <div class="section-card col-6 fade-in-up">
            <div class="section-header">
                <h2 class="section-title">
                    📝 Plantillas más Usadas
                </h2>
                <a href="/admin/core/plantilla/" class="section-action">Ver Todas</a>
            </div>
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Plantilla</th>
                        <th style="text-align: center;">Categoría</th>
                        <th style="text-align: right;">Usos</th>
                    </tr>
                </thead>
                <tbody>
                    {% for plantilla in top_plantillas %}
                    <tr>
                        <td>
                            <strong>{{ plantilla.nombre }}</strong>
                            {% if plantilla.aprobada_twilio %}
                            <span class="table-badge badge-success">✅ Aprobada</span>
                            {% endif %}
                        </td>
                        <td style="text-align: center;">
                            <span class="table-badge badge-info">{{ plantilla.categoria|default:"General" }}</span>
                        </td>
                        <td style="text-align: right; font-weight: 700;">{{ plantilla.veces_usada }}</td>
                    </tr>
                    {% empty %}
                    <tr>
                        <td colspan="3" style="text-align: center; color: #94a3b8; padding: 30px;">
                            No hay plantillas disponibles
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <!-- SOPORTE -->
        <div class="section-card col-6 fade-in-up">
            <div class="section-header">
                <h2 class="section-title">
                    🎧 Estado del Soporte
                </h2>
                <a href="/admin/core/solicitudsoporte/" class="section-action">Ver Solicitudes</a>
            </div>
            <ul class="stats-list">
                <li class="stat-item">
                    <span class="stat-label">
                        <span>⏳</span> Pendientes
                    </span>
                    <span class="stat-value" style="color: var(--warning);">{{ solicitudes_pendientes|default:0 }}</span>
                </li>
                <li class="stat-item">
                    <span class="stat-label">
                        <span>🔧</span> En Atención
                    </span>
                    <span class="stat-value" style="color: var(--info);">{{ solicitudes_atendiendo|default:0 }}</span>
                </li>
                <li class="stat-item">
                    <span class="stat-label">
                        <span>✅</span> Resueltas
                    </span>
                    <span class="stat-value" style="color: var(--success);">{{ solicitudes_resueltas|default:0 }}</span>
                </li>
                <li class="stat-item">
                    <span class="stat-label">
                        <span>📊</span> Total
                    </span>
                    <span class="stat-value">{{ total_solicitudes|default:0 }}</span>
                </li>
            </ul>
            <div class="progress-bar-container" style="margin-top: 20px;">
                <div class="progress-label">
                    <span style="font-weight: 600;">Tasa de Resolución</span>
                    <span>
                        {% if total_solicitudes > 0 %}
                            {% widthratio solicitudes_resueltas total_solicitudes 100 %}%
                        {% else %}
                            0%
                        {% endif %}
                    </span>
                </div>
                <div class="progress-bar-bg">
                    <div class="progress-bar-fill" style="width: {% if total_solicitudes > 0 %}{% widthratio solicitudes_resueltas total_solicitudes 100 %}{% else %}0{% endif %}%;"></div>
                </div>
            </div>
        </div>

        <!-- GAMIFICACIÓN -->
        <div class="section-card col-6 fade-in-up">
            <div class="section-header">
                <h2 class="section-title">
                    🏆 Gamificación
                </h2>
                <a href="/admin/core/perfilgamificacion/" class="section-action">Ver Perfiles</a>
            </div>
            <ul class="stats-list">
                <li class="stat-item">
                    <span class="stat-label">
                        <span>⭐</span> Puntos Otorgados
                    </span>
                    <span class="stat-value">{{ total_puntos_otorgados|default:0|floatformat:0 }}</span>
                </li>
                <li class="stat-item">
                    <span class="stat-label">
                        <span>💎</span> Puntos Canjeados
                    </span>
                    <span class="stat-value">{{ total_puntos_canjeados|default:0|floatformat:0 }}</span>
                </li>
                <li class="stat-item">
                    <span class="stat-label">
                        <span>🏅</span> Badges Otorgados
                    </span>
                    <span class="stat-value">{{ badges_otorgados|default:0 }}</span>
                </li>
                <li class="stat-item">
                    <span class="stat-label">
                        <span>👤</span> Perfiles Activos
                    </span>
                    <span class="stat-value">{{ perfiles_gamificacion|default:0 }}</span>
                </li>
            </ul>
        </div>

    </div>
</div>

<script>
// ========== GRÁFICA DE ACTIVIDAD ==========
document.addEventListener('DOMContentLoaded', function() {
    const ctx = document.getElementById('activityChart');
    if (!ctx) return;

    const activityChart = new Chart(ctx, {
        type: 'line',
        data: {
            labels: {{ fechas_json|safe }},
            datasets: [{
                label: 'Mensajes Totales',
                data: {{ mensajes_diarios_json|safe }},
                borderColor: '#667eea',
                backgroundColor: 'rgba(102, 126, 234, 0.1)',
                borderWidth: 3,
                fill: true,
                tension: 0.4,
                pointBackgroundColor: '#667eea',
                pointBorderColor: '#fff',
                pointBorderWidth: 2,
                pointRadius: 5,
                pointHoverRadius: 8
            }, {
                label: 'Mensajes Enviados',
                data: {{ envios_diarios_json|safe }},
                borderColor: '#10b981',
                backgroundColor: 'rgba(16, 185, 129, 0.1)',
                borderWidth: 3,
                fill: true,
                tension: 0.4,
                pointBackgroundColor: '#10b981',
                pointBorderColor: '#fff',
                pointBorderWidth: 2,
                pointRadius: 5,
                pointHoverRadius: 8
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    position: 'top',
                    labels: {
                        usePointStyle: true,
                        padding: 20,
                        font: {
                            family: 'Inter',
                            size: 13,
                            weight: '600'
                        }
                    }
                },
                tooltip: {
                    backgroundColor: 'rgba(30, 41, 59, 0.95)',
                    titleColor: '#fff',
                    bodyColor: '#fff',
                    cornerRadius: 12,
                    padding: 12,
                    displayColors: true,
                    bodyFont: {
                        family: 'Inter',
                        size: 13
                    },
                    titleFont: {
                        family: 'Inter',
                        size: 14,
                        weight: 'bold'
                    }
                }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    grid: {
                        color: 'rgba(0, 0, 0, 0.05)',
                        drawBorder: false
                    },
                    ticks: {
                        font: {
                            family: 'Inter',
                            size: 12
                        },
                        callback: function(value) {
                            return value.toLocaleString();
                        }
                    }
                },
                x: {
                    grid: {
                        display: false,
                        drawBorder: false
                    },
                    ticks: {
                        font: {
                            family: 'Inter',
                            size: 12
                        }
                    }
                }
            },
            interaction: {
                intersect: false,
                mode: 'index'
            },
            animation: {
                duration: 1500,
                easing: 'easeInOutQuart'
            }
        }
    });

    // Animación de entrada para las tarjetas
    const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry, index) => {
            if (entry.isIntersecting) {
                setTimeout(() => {
                    entry.target.style.opacity = '1';
                    entry.target.style.transform = 'translateY(0)';
                }, index * 100);
            }
        });
    }, { threshold: 0.1 });

    document.querySelectorAll('.fade-in-up').forEach(el => {
        el.style.opacity = '0';
        el.style.transform = 'translateY(30px)';
        el.style.transition = 'all 0.6s ease-out';
        observer.observe(el);
    });

    // Auto-refresh cada 5 minutos
    setTimeout(() => {
        location.reload();
    }, 300000);
});
</script>
{% endblock %}